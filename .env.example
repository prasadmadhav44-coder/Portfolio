# Resend (powers the Contact form) — https://resend.com
# These are read server-side only, inside /api/contact.js — never
# prefix them with VITE_ or they'd get bundled into client-side JS.
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL="Portfolio <contact@yourdomain.com>"

# Supabase (optional — persists every contact submission as a durable
# record, in addition to the email). Read server-side only, inside
# api/lib/supabaseAdmin.js. Leave both blank to skip the DB write; the
# contact form still works purely on Resend. Run supabase/schema.sql in
# your project's SQL Editor before setting these.
#   SUPABASE_URL              → Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY → Project Settings → API → service_role key
#                                (secret — never expose client-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 (optional) — leave blank to disable
VITE_GA_MEASUREMENT_ID=

# Supabase — CMS (admin panel at /admin: Projects, About, Tech Stack,
# Experience, Education, Certifications). Read client-side, so these DO
# need the VITE_ prefix — they're the anon key, safe to ship to the
# browser (Row Level Security in supabase/schema_cms.sql restricts what
# it can actually do). Leave both blank to run the site purely on its
# built-in static content, with /admin disabled.
#   VITE_SUPABASE_URL       → Project Settings → API → Project URL
#   VITE_SUPABASE_ANON_KEY  → Project Settings → API → anon public key
# See README.md "Content Management System" section for full setup steps.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
